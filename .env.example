PORT=3000

# Используйте DATABASE_URL на Vercel, например строку подключения PostgreSQL от Supabase/Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true

# Локальная альтернатива вместо DATABASE_URL.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=personal_account
DB_PASSWORD=your_password_here
DB_PORT=5432

JWT_SECRET=replace_with_long_random_secret
