PORT=3000

# Используйте DATABASE_URL на Vercel, например строку подключения PostgreSQL от Supabase/Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true

# Локальная альтернатива вместо DATABASE_URL.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=personal_account
DB_PASSWORD=your_password_here
DB_PORT=5432

JWT_SECRET=replace_with_long_random_secret

# Email-коды подтверждения регистрации и изменения профиля.
# Подойдут SMTP-данные почтового сервиса: Яндекс, Gmail, Mail.ru, корпоративная почта, SendGrid и т.п.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM="PRANA IT <no-reply@example.com>"
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5

# Опционально: начальный администратор. Если указан, пароль обновится при старте API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_admin_password

# Опционально: нейросеть для чат-бота. Без ключа бот использует подготовленные ответы.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
